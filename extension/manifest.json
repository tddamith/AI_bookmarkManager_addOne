{
  "manifest_version": 3,
  "name": "Stash \u2014 AI Bookmark Manager",
  "version": "0.1.0",
  "description": "Save, organize and find your bookmarks with AI \u2014 in a side panel.",
  "permissions": [
    "activeTab",
    "bookmarks",
    "contextMenus",
    "favicon",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [],
  "action": {
    "default_title": "Open Stash",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_page": "options/options.html",
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Stash side panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aibookmarkmanager@example.com"
    }
  },
  "side_panel": {
    "default_path": "popup/home.html"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}